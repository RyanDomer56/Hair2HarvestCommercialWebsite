{
  "name": "hair2harvest-commercial-website",
  "version": "1.0.0",
  "private": true,
  "description": "Hair2Harvest — commercial website and operations system for a barbershop hair-to-compost network.",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
