# Web app. All optional — the site renders from typed fixtures when unset.
# Point both at the Express service to read and write live MongoDB data.
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

# Vercel project env: set API_URL to the deployed Express host.
# The Express service itself reads MONGODB_URI (see apps/api/.env.example).

# ---------------------------------------------------------------------------
# CHATBOT AI (OPTIONAL — the chatbot works fully with these unset)
# ---------------------------------------------------------------------------
# With no key, the assistant answers from the site's verified facts at zero
# cost, works offline, and still points visitors to the right page. Set all
# three values below to switch on AI-written answers. Any OpenAI-compatible
# "/chat/completions" endpoint works; the key stays server-side only.
#
# FREE OPTION 1 — Google Gemini (free tier, no credit card required)
#   Get a key at https://aistudio.google.com/app/apikey
#   CHAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   CHAT_MODEL=gemini-2.0-flash
#   CHAT_API_KEY=your_key_here
#
# FREE OPTION 2 — OpenRouter free models (no credit card required)
#   Get a key at https://openrouter.ai/keys
#   CHAT_BASE_URL=https://openrouter.ai/api/v1
#   CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   CHAT_API_KEY=your_key_here
#
# FREE OPTION 3 — Groq (free developer tier)
#   Get a key at https://console.groq.com/keys
#   CHAT_BASE_URL=https://api.groq.com/openai/v1
#   CHAT_MODEL=llama-3.3-70b-versatile
#   CHAT_API_KEY=your_key_here
#
# PAID OPTION — the actual OpenAI / ChatGPT API (pay per token; NO free tier)
#   CHAT_BASE_URL=https://api.openai.com/v1
#   CHAT_MODEL=gpt-4o-mini
#   CHAT_API_KEY=your_key_here
#
# On Vercel: add these three as Project Environment Variables (Server-side,
# never NEXT_PUBLIC_*). Redeploy afterwards. Check /api/v1/chat for the mode.
# Safety: answers are grounded in the site's checked facts; the model is told
# never to invent pickup times, registration details or contact information.
# If the AI call fails or times out, the verified local answer is used.
